---
import Layout from "../layouts/Layout.astro";
---

<Layout title="点字フォント比較(テスト用)">
	<h1>点字フォント比較</h1>
	<p>
		<kbd>F</kbd><kbd>D</kbd><kbd>S</kbd><kbd>J</kbd><kbd>K</kbd><kbd>L</kbd>キーで点字を打って、見え方を比べてみてください。
	</p>

	<div class="box">
		<label for="input-dejavu">DejaVu Sans Mono</label>
		<textarea id="input-dejavu" class="dejavu" rows="4" autocomplete="off" spellcheck="false"></textarea>
	</div>

	<div class="box">
		<label for="input-default">ブラウザのデフォルト(フォント指定なし)</label>
		<textarea id="input-default" class="default" rows="4" autocomplete="off" spellcheck="false"></textarea>
	</div>
</Layout>

<style>
	kbd {
		display: inline-block;
		min-width: 1.5em;
		padding: 0.1em 0.4em;
		border: 1px solid #888;
		border-radius: 4px;
		background: #f5f5f5;
		font-family: inherit;
		text-align: center;
	}

	.box {
		margin: 1.5rem 0;
	}

	label {
		display: block;
		margin-bottom: 0.3rem;
		font-weight: bold;
	}

	textarea {
		width: 100%;
		max-width: 32rem;
		font-size: 2rem;
		line-height: 1.8;
		resize: vertical;
	}

	textarea.dejavu {
		font-family: var(--font-braille);
	}

	/* .default は意図的にfont-familyを指定しない(他ページの変更前と同じ、UA既定のまま)。 */
</style>

<script>
	import { attachBrailleInput } from "../lib/brailleInput";

	attachBrailleInput({ textarea: document.getElementById("input-dejavu") as HTMLTextAreaElement });
	attachBrailleInput({ textarea: document.getElementById("input-default") as HTMLTextAreaElement });
</script>
