---
import Layout from "../layouts/Layout.astro";
---

<Layout title="点字フォント比較(テスト用)">
	<h1>点字フォント比較</h1>
	<p>
		<kbd>F</kbd><kbd>D</kbd><kbd>S</kbd><kbd>J</kbd><kbd>K</kbd><kbd>L</kbd>キーで点字を打って、見え方を比べてみてください。
	</p>

	<div class="box">
		<label for="input-dejavu">DejaVu Sans(点字グリフのみ等幅)</label>
		<textarea id="input-dejavu" class="dejavu braille-textarea" rows="4" autocomplete="off" spellcheck="false"
		></textarea>
	</div>

	<div class="box">
		<label for="input-default">ブラウザのデフォルト(フォント指定なし)</label>
		<textarea id="input-default" class="default braille-textarea" rows="4" autocomplete="off" spellcheck="false"
		></textarea>
	</div>
</Layout>

<style>
	.box {
		margin: 1.5rem 0;
	}

	textarea.dejavu {
		font-family: var(--font-braille);
	}

	/* .default は意図的にfont-familyを指定しない(他ページの変更前と同じ、UA既定のまま)。 */
</style>

<script>
	import { attachBrailleInput } from "../lib/brailleInput";

	attachBrailleInput({ textarea: document.getElementById("input-dejavu") as HTMLTextAreaElement });
	attachBrailleInput({ textarea: document.getElementById("input-default") as HTMLTextAreaElement });
</script>
