---
import Layout from "../layouts/Layout.astro";
import { YOON_COLUMNS, YOON_SEION_ROWS, YOON_DAKUON_ROWS, SPECIAL_SOUNDS } from "../data/yoon";
---

<Layout title="拗音・特殊音も覚えよう" pageSlug="yoon">
	<h1>拗音・特殊音も覚えよう</h1>
	<p>
		「きゃ」「しゅ」「ちょ」のように、小さい「ゃゅょ」がつく音を<strong>拗音(ようおん)</strong>というよ。点字では、2つのマスを使って表すんだ。最初のマスが「次の音と組み合わせるよ」という印で、2つ目のマスがもとになる音を表しているよ。
	</p>

	<table>
		<caption>拗音(清音)</caption>
		<thead>
			<tr>
				<th scope="col"></th>
				{YOON_COLUMNS.map((col) => <th scope="col">{col}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				YOON_SEION_ROWS.map((row) => (
					<tr>
						<th scope="row">{row.label}</th>
						{row.cells.map((cell) => (
							<td>
								<span class="kana">{cell.kana}</span>
								<span class="braille">{cell.braille}</span>
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>

	<table>
		<caption>拗音(濁音・半濁音)</caption>
		<thead>
			<tr>
				<th scope="col"></th>
				{YOON_COLUMNS.map((col) => <th scope="col">{col}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				YOON_DAKUON_ROWS.map((row) => (
					<tr>
						<th scope="row">{row.label}</th>
						{row.cells.map((cell) => (
							<td>
								<span class="kana">{cell.kana}</span>
								<span class="braille">{cell.braille}</span>
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>

	<p>
		もうひとつ、覚えておきたい音があるよ。<strong>促音(そくおん)</strong>の「っ」と、<strong
			>長音符(ちょうおんぷ)</strong
		>の「ー」だよ。どちらも、それぞれ1つのマスで表すんだ。
	</p>

	<table>
		<caption>特殊音</caption>
		<thead>
			<tr>
				<th scope="col">文字</th>
				<th scope="col">点字</th>
				<th scope="col">はたらき</th>
			</tr>
		</thead>
		<tbody>
			{
				SPECIAL_SOUNDS.map((s) => (
					<tr>
						<th scope="row">{s.label}</th>
						<td class="braille">{s.braille}</td>
						<td class="description">{s.description}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<p>
		これで、五十音・濁音・半濁音・拗音・特殊音がそろったよ。ここまで覚えれば、自分の名前もほとんど点字で書けるはずだよ！
	</p>

	<h2>単語をあててみよう</h2>
	<p class="word-prompt">「<span id="word-prompt"></span>」</p>

	<label for="braille-input">打った点字</label>
	<textarea id="braille-input" rows="3" autocomplete="off" spellcheck="false"></textarea>

	<p class="buttons">
		<button type="button" id="check-button">こたえあわせ</button>
		<button type="button" id="next-button">つぎのもんだい</button>
	</p>

	<p id="feedback" aria-live="polite"></p>
	<p id="score"></p>
</Layout>

<style>
	table {
		border-collapse: collapse;
		margin: 1rem 0 1.5rem;
	}

	caption {
		font-weight: bold;
		text-align: left;
		margin-bottom: 0.3rem;
	}

	th,
	td {
		border: 1px solid #ccc;
		padding: 0.3rem 0.6rem;
		text-align: center;
	}

	.kana {
		display: block;
		font-size: 1rem;
	}

	.braille {
		display: block;
		font-size: 1.3rem;
	}

	.description {
		text-align: left;
		font-size: 0.95rem;
	}

	.word-prompt {
		font-size: 1.8rem;
		font-weight: bold;
	}

	#braille-input {
		width: 100%;
		max-width: 32rem;
		font-size: 2rem;
		line-height: 1.8;
		resize: vertical;
	}

	.buttons {
		display: flex;
		gap: 0.5rem;
	}

	.buttons button {
		font-size: 1rem;
		padding: 0.4rem 0.8rem;
	}

	#feedback.correct {
		color: #0a7a2f;
		font-weight: bold;
	}

	#feedback.incorrect {
		color: #b3261e;
		font-weight: bold;
	}

	#score {
		color: #555;
	}
</style>

<script>
	import { attachBrailleInput } from "../lib/brailleInput";
	import { YOON_WORDS as WORDS, type Word } from "../data/words";

	const input = document.getElementById("braille-input") as HTMLTextAreaElement;
	const wordPrompt = document.getElementById("word-prompt") as HTMLElement;
	const checkButton = document.getElementById("check-button") as HTMLButtonElement;
	const nextButton = document.getElementById("next-button") as HTMLButtonElement;
	const feedback = document.getElementById("feedback") as HTMLElement;
	const score = document.getElementById("score") as HTMLElement;

	attachBrailleInput({ textarea: input });

	let currentWord: Word = WORDS[0];
	let correctCount = 0;
	let totalCount = 0;

	function pickWord(exclude?: Word): Word {
		const candidates = WORDS.length > 1 ? WORDS.filter((w) => w !== exclude) : WORDS;
		return candidates[Math.floor(Math.random() * candidates.length)];
	}

	function showWord(word: Word) {
		currentWord = word;
		wordPrompt.textContent = word.kana;
		feedback.textContent = "";
		feedback.className = "";
		input.value = "";
		input.focus();
	}

	function updateScore() {
		score.textContent = `せいかい: ${correctCount} / ぜんぶ: ${totalCount}もん`;
	}

	checkButton.addEventListener("click", () => {
		totalCount++;
		if (input.value.trim() === currentWord.braille) {
			correctCount++;
			feedback.textContent = "せいかい！";
			feedback.className = "correct";
		} else {
			feedback.textContent = `ざんねん。せいかいは「${currentWord.braille}」だったよ`;
			feedback.className = "incorrect";
		}
		updateScore();
	});

	nextButton.addEventListener("click", () => {
		showWord(pickWord(currentWord));
	});

	showWord(pickWord());
	updateScore();
</script>
