---
import Layout from "../layouts/Layout.astro";
import BrailleKeyboardGuide from "../components/BrailleKeyboardGuide.astro";
---

<Layout title="自由に書いてみよう" pageSlug="write-freely">
	<h1>自由に書いてみよう</h1>
	<p>
		キーボードのキーを使って点字を打つ体験ができます。下の図を参考にしながら、点字を打ってみよう！
	</p>

	<BrailleKeyboardGuide />

	<div class="practice">
		<label for="braille-input">打った点字</label>
		<textarea id="braille-input" class="braille-textarea" rows="6" autocomplete="off" spellcheck="false"
		></textarea>

		<div class="kana-box">
			<span id="kana-output-label">よみ（カタカナ）</span>
			<p id="kana-output" aria-live="polite" aria-labelledby="kana-output-label">
				（読みこみ中…）
			</p>
		</div>
	</div>
</Layout>

<style>
	.practice {
		margin-top: 1.5rem;
	}

	.kana-box {
		margin-top: 1rem;
	}

	#kana-output {
		font-size: 1.5rem;
	}
</style>

<script>
	import init, { BrailleBackTranslator } from "momors-wasm";
	import { attachBrailleInput } from "../lib/brailleInput";

	const input = document.getElementById("braille-input") as HTMLTextAreaElement;
	const kanaOutput = document.getElementById("kana-output") as HTMLElement;

	let backTranslator: BrailleBackTranslator | null = null;

	async function setup() {
		await init();
		backTranslator = new BrailleBackTranslator();
		kanaOutput.textContent = "";
		kanaOutput.textContent = backTranslator.backTranslate(input.value);
	}

	setup().catch((err) => {
		kanaOutput.textContent = "(読みこみに失敗しました)";
		console.error(err);
	});

	attachBrailleInput({ textarea: input });

	// セルの確定(attachBrailleInputが発火させるinput)・Backspace等の編集、
	// どちらもここでtextarea全体をまるごと再変換するので、部分的な追記によるズレが起きない。
	input.addEventListener("input", () => {
		if (!backTranslator) return;
		kanaOutput.textContent = backTranslator.backTranslate(input.value);
	});
</script>
