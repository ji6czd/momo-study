---
import Layout from "../layouts/Layout.astro";
import { SENTENCE_WORDS as WORDS } from "../data/words";
---

<Layout title="文章を書いてみよう" pageSlug="sentences">
	<h1>文章を書いてみよう</h1>
	<p>すばらしい！ここまできたら、もう文章が書けるね。</p>

	<p>
		文章を書くのに、あと2つだけ道具を覚えよう。<strong>句点(くてん)</strong>の「。」と、<strong
			>読点(とうてん)</strong
		>の「、」だよ。
	</p>

	<table>
		<caption>句読点</caption>
		<thead>
			<tr>
				<th scope="col">記号</th>
				<th scope="col">点字</th>
				<th scope="col">はたらき</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<th scope="row">。(句点)</th>
				<td class="braille">⠲</td>
				<td class="description">文の終わりに書く。あとに文が続くときは2マスあける</td>
			</tr>
			<tr>
				<th scope="row">、(読点)</th>
				<td class="braille">⠰</td>
				<td class="description">文の区切りに書く。あとに文が続くときは1マスあける</td>
			</tr>
		</tbody>
	</table>

	<p>文の途中に句点がくる例を見てみよう。</p>
	<p class="example">雪がふりました。がっこうが休みになりました。</p>
	<p class="braille-example">⠬⠣⠐⠡⠀⠭⠓⠵⠳⠕⠲⠀⠀⠐⠡⠂⠪⠒⠐⠡⠀⠌⠹⠷⠇⠀⠅⠓⠵⠳⠕⠲</p>
	<p>
		ふつうの文字では「。」のあとにスペースを空けたりしないけど、点字では2マス空くのがわかるかな？
	</p>

	<p>
		単語の書き方も、分かち書きもわかったから、もう文章が書けるはずだよ。実際にやってみよう。
	</p>

	<table>
		<caption>例文</caption>
		<thead>
			<tr>
				<th scope="col">もとの文</th>
				<th scope="col">かな</th>
				<th scope="col">点字</th>
			</tr>
		</thead>
		<tbody>
			{
				WORDS.map((w) => (
					<tr>
						<th scope="row">{w.source}</th>
						<td>{w.kana}</td>
						<td class="braille">{w.braille}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h2>文章を打ってみよう</h2>
	<p>区切りは<kbd>Space</kbd>キーだけを押してね。「。」「、」も点字のマスとして打てるよ。</p>
	<p class="word-prompt">「<span id="word-prompt"></span>」</p>

	<label for="braille-input">打った点字</label>
	<textarea id="braille-input" rows="4" autocomplete="off" spellcheck="false"></textarea>

	<p class="buttons">
		<button type="button" id="check-button">こたえあわせ</button>
		<button type="button" id="next-button">つぎのもんだい</button>
	</p>

	<p id="feedback" aria-live="polite"></p>
	<p id="score"></p>
</Layout>

<style>
	kbd {
		display: inline-block;
		min-width: 1.5em;
		padding: 0.1em 0.4em;
		border: 1px solid #888;
		border-radius: 4px;
		background: #f5f5f5;
		font-family: inherit;
		text-align: center;
	}

	table {
		border-collapse: collapse;
		margin: 1rem 0 1.5rem;
	}

	caption {
		font-weight: bold;
		text-align: left;
		margin-bottom: 0.3rem;
	}

	th,
	td {
		border: 1px solid #ccc;
		padding: 0.3rem 0.6rem;
		text-align: center;
	}

	.braille {
		font-size: 1.3rem;
	}

	.example {
		font-size: 1.1rem;
		padding: 0.5rem 0.8rem;
		background: #f5f5f5;
		border-radius: 4px;
		display: inline-block;
	}

	.braille-example {
		font-size: 1.3rem;
		padding: 0.5rem 0.8rem;
		background: #f5f5f5;
		border-radius: 4px;
		display: inline-block;
	}

	.description {
		text-align: left;
		font-size: 0.95rem;
	}

	.word-prompt {
		font-size: 1.5rem;
		font-weight: bold;
	}

	#braille-input {
		width: 100%;
		max-width: 32rem;
		font-size: 2rem;
		line-height: 1.8;
		resize: vertical;
	}

	.buttons {
		display: flex;
		gap: 0.5rem;
	}

	.buttons button {
		font-size: 1rem;
		padding: 0.4rem 0.8rem;
	}

	#feedback.correct {
		color: #0a7a2f;
		font-weight: bold;
	}

	#feedback.incorrect {
		color: #b3261e;
		font-weight: bold;
	}

	#score {
		color: #555;
	}
</style>

<script>
	import { attachBrailleInput } from "../lib/brailleInput";
	import { SENTENCE_WORDS as WORDS, type KanjiWord } from "../data/words";

	const input = document.getElementById("braille-input") as HTMLTextAreaElement;
	const wordPrompt = document.getElementById("word-prompt") as HTMLElement;
	const checkButton = document.getElementById("check-button") as HTMLButtonElement;
	const nextButton = document.getElementById("next-button") as HTMLButtonElement;
	const feedback = document.getElementById("feedback") as HTMLElement;
	const score = document.getElementById("score") as HTMLElement;

	attachBrailleInput({ textarea: input });

	let currentWord: KanjiWord = WORDS[0];
	let correctCount = 0;
	let totalCount = 0;

	function pickWord(exclude?: KanjiWord): KanjiWord {
		const candidates = WORDS.length > 1 ? WORDS.filter((w) => w !== exclude) : WORDS;
		return candidates[Math.floor(Math.random() * candidates.length)];
	}

	function showWord(word: KanjiWord) {
		currentWord = word;
		wordPrompt.textContent = word.source;
		feedback.textContent = "";
		feedback.className = "";
		input.value = "";
		input.focus();
	}

	function updateScore() {
		score.textContent = `せいかい: ${correctCount} / ぜんぶ: ${totalCount}もん`;
	}

	checkButton.addEventListener("click", () => {
		totalCount++;
		if (input.value.trim() === currentWord.braille) {
			correctCount++;
			feedback.textContent = "せいかい！";
			feedback.className = "correct";
		} else {
			feedback.textContent = `ざんねん。せいかいは「${currentWord.braille}」だったよ`;
			feedback.className = "incorrect";
		}
		updateScore();
	});

	nextButton.addEventListener("click", () => {
		showWord(pickWord(currentWord));
	});

	showWord(pickWord());
	updateScore();
</script>
