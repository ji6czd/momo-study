---
import { withBase } from "../lib/url";
import { getNextPage } from "../data/pages";
import BrailleChart from "../components/BrailleChart.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	/** data/pages.ts 上のスラッグ。指定すると本文末尾に「次のページへ」リンクを出す。 */
	pageSlug?: string;
}

const { title, pageSlug } = Astro.props;
const siteName = "モモさんと点字を学ぼう！";
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const nextPage = pageSlug ? getNextPage(pageSlug) : null;

// @font-face の url() はCSSカスタムプロパティを解決できない(要素に紐付かないため)ので、
// base込みのURLをビルド時に文字列として直接埋め込む。
//
// 点字表示に使うフォント本体はSixBraille(点字専用フォント、自己ホスト、
// public/fonts/sixbraille/)。パブリックドメイン。詳細は
// public/fonts/sixbraille/LICENSE.txt を参照。
// 点の形(点/白丸/小白丸/小黒丸/横線/斜線)×枠あり/なしの12バリアントの中から、
// 横線・枠ありスタイル(hlf = sixbraille41)を採用した。他バリアントとの
// 比較はfont-compare.astroを参照(採用フォント以外はそちら側で個別に読み込む)。
// :root の --font-braille 定義と、それを適用するクラス/IDの一覧は styles/global.css 側。
const brailleFontUrl = withBase("fonts/sixbraille/sixbraille41.woff2");
const brailleFontFaceCss = `
	@font-face {
		font-family: "SixBraille (hlf)";
		src: url("${brailleFontUrl}") format("woff2");
		font-display: swap;
	}
`;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
		<link rel="icon" href={withBase("favicon.ico")} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<style is:global set:html={brailleFontFaceCss} />
	</head>
	<body>
		<a class="skip-link" href="#main">本文へスキップ</a>
		<header>
			<a href={withBase("")} class="header-logo">
				<img
					src={withBase("images/momo-avatar.jpg")}
					alt="モモ"
					class="header-avatar"
					width="40"
					height="40"
				/>
				<span>{siteName}</span>
			</a>
		</header>
		<main id="main">
			<slot />
			{
				nextPage && (
					<nav class="next-page" aria-label="次のページ">
						<a href={withBase(nextPage.slug)}>つぎ：{nextPage.title} →</a>
					</nav>
				)
			}
		</main>
		<footer>
			<a href={withBase("about")}>このサイトについて</a>
		</footer>
		<BrailleChart pageSlug={pageSlug} />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
	}
	.skip-link:focus {
		left: 0;
		z-index: 100;
		padding: 0.5em 1em;
		background: #fff;
	}

	header {
		padding: 0.8rem 0;
		border-bottom: 1px solid #eee;
	}

	.header-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: bold;
		font-size: 1.2rem;
		color: #333;
		text-decoration: none;
	}

	.header-logo:hover {
		opacity: 0.85;
	}

	.header-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
		border: 1.5px solid #ffe8cc;
	}

	/* 右下固定の「点字表を見る」ボタン(BrailleChart.astro)と、ページ末尾のコンテンツが
	   スクロール時に重ならないよう、本文の下に余白を確保しておく。 */
	main {
		padding-bottom: 4.5rem;
	}

	.next-page {
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid #ccc;
		text-align: right;
	}

	.next-page a {
		font-size: 1.1rem;
		font-weight: bold;
	}

	footer {
		margin-top: 2rem;
		padding: 1rem 0;
		text-align: center;
		font-size: 0.85rem;
	}

	footer a {
		color: #555;
	}
</style>
